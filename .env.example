# LM Studio Auto Optimizer - Environment Configuration
# Copy to .env and adjust:  cp .env.example .env  (or copy .env.example .env on Windows)

# LM Studio Developer API endpoint (local default)
LM_STUDIO_URL=http://127.0.0.1:1234
# Alternative remote example (Tailscale/VPN):
# LM_STUDIO_URL=http://192.168.1.100:1234

# Web UI
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Database & storage (all under ./data/)
# DATABASE_PATH=./data/optimizer.db
# RESULTS_DIR=./data/reports
# PRESETS_DIR=./data/presets
# LOGS_DIR=./data/logs

# Optimization defaults
# DEFAULT_PROFILE=balanced
# DEFAULT_QUALITY_THRESHOLD=0.97

# Hardware overrides (auto-detected if not set)
# HW_GPU_VRAM_GB=
# HW_SYSTEM_RAM_GB=
# HW_GPU_NAME=

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Safety
# SAFETY_AUTO_UNLOAD_BETWEEN_TESTS=true
# SAFETY_FORCE_UNLOAD_ON_ERROR=true
