# LM Studio Auto Optimizer - example configuration.
# Copy to .env and adjust. ALL values optional (sane defaults built in).
# See lm_optimizer/config.py for the full reference.

# LM Studio server (Developer API must be enabled in LM Studio)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234

# Web UI
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8080

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
